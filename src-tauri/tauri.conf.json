{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3dpixel",
  "version": "0.1.0",
  "identifier": "com.tedtalksbits.3dpixel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "3dpixel",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["kenshape"],
        "name": "Kenney Shape project",
        "description": "Kenney Shape project",
        "role": "Editor"
      }
    ]
  }
}
